# Development / production mode
LOCAL_DEV=0
FLASK_DEBUG=0
FLASK_AUTO_RELOAD=0

# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
TRUSTED_HOSTS=rainwave.top,www.rainwave.top

# Database
DATABASE_URL=

# Reverse proxy and shared rate limiting
PROXY_FIX_ENABLED=true
PROXY_FIX_X_FOR=1
PROXY_FIX_X_PROTO=1
PROXY_FIX_X_HOST=1
RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0

# Optional account and bot protection
ADMIN_TOTP_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional Hermes integration
HERMES_API_URL=
HERMES_API_KEY=
