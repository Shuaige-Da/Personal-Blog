# Development / production mode
LOCAL_DEV=0
FLASK_DEBUG=0
FLASK_AUTO_RELOAD=0

# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
TRUSTED_HOSTS=rainwave.top,www.rainwave.top

# Database
DATABASE_URL=

# Reverse proxy and shared rate limiting
PROXY_FIX_ENABLED=true
PROXY_FIX_X_FOR=1
PROXY_FIX_X_PROTO=1
PROXY_FIX_X_HOST=1
RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0

# Optional account and bot protection
ADMIN_TOTP_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional Hermes integration. Production loads these values through
# /etc/rainwave/rainwave.env. For local testing, use .env.local.example.
HERMES_API_URL=
HERMES_API_KEY=
HERMES_ATTACHMENT_FOLDER=/var/www/rainwave-shared/hermes-attachments
HERMES_ATTACHMENT_MAX_COUNT=5
HERMES_ATTACHMENT_IMAGE_MAX_BYTES=10485760
HERMES_ATTACHMENT_DOCUMENT_MAX_BYTES=20971520
HERMES_ATTACHMENT_TOTAL_MAX_BYTES=31457280
HERMES_ATTACHMENT_TEXT_MAX_CHARS=100000
HERMES_ATTACHMENT_TURN_TEXT_MAX_CHARS=200000
HERMES_EDITOR_CONTEXT_MAX_CHARS=50000

# Required for lossless browser-playback variants
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
AUDIO_PROCESS_TIMEOUT_SECONDS=300
