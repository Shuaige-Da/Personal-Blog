# Private local overrides loaded by start_local.ps1.
# Copy this file to .env.local. The real .env.local is ignored by Git.

# Keep the server Hermes API bound to 127.0.0.1. Before starting RainWave,
# create an SSH tunnel from this computer to the server, for example:
# ssh -N -L 8642:127.0.0.1:8642 <server-user>@<server-host>
HERMES_API_URL=http://127.0.0.1:8642/v1/chat/completions
HERMES_API_KEY=
